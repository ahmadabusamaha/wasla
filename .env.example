# ── App ────────────────────────────────────────────────────────────
# Public site URL (used for metadata, canonical URLs, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ───────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ Never expose SUPABASE_SERVICE_ROLE_KEY to the client.
# This project intentionally does not use service_role anywhere.

# ── OAuth (optional) ───────────────────────────────────────────────
# Google OAuth is configured in Supabase Dashboard → Auth → Providers.
# Set the redirect URL there to: {NEXT_PUBLIC_SITE_URL}/auth/callback
